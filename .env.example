# Core
NEXT_PUBLIC_APP_URL=https://harune.me
NEXT_PUBLIC_SIGNIN_ENABLED=true

# Analytics (provider: betterlytics | umami)
NEXT_PUBLIC_ANALYTICS_PROVIDER= # betterlytics or umami

NEXT_PUBLIC_BETTERLYTICS_SITE_ID= # required when provider=betterlytics
NEXT_PUBLIC_BETTERLYTICS_SCRIPT_SRC=https://betterlytics.io/analytics.js

UMAMI_API_BASE_URL=
UMAMI_API_KEY=
NEXT_PUBLIC_UMAMI_WEBSITE_ID= # required when provider=umami
NEXT_PUBLIC_UMAMI_SCRIPT_SRC=https://cloud.umami.is/script.js

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://harune.me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (Neon, Supabase, PlanetScale)
DATABASE_URL=

NEXT_PUBLIC_DATABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=
SUPABASE_S3_BUCKET_NAME=

# Stripe Configuration
STRIPE_WEBHOOK_SECRET=whsec_xxx...    # From Stripe webhook settings
STRIPE_PUBLISHABLE_KEY=pk_test_xxx... # From Stripe API keys
STRIPE_SECRET_KEY=sk_test_xxx...      # From Stripe API keys

# Dodo Payments Configuration
 DODO_PAYMENTS_API_KEY=xxx... # From Dodo Payments API keys
 DODO_PAYMENTS_WEBHOOK_SECRET=whsec_xxx... # From Dodo Payments webhook settings
 DODO_PAYMENTS_API_URL="https://live.dodopayments.com" # Or test.dodopayments.com for testing

# LemonSqueezy Configuration
LEMON_SQUEEZY_API_KEY=your-api-key
LEMON_SQUEEZY_STORE_ID=your-store-id
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-secret

# Paddle Payments Configuration
PADDLE_API_KEY=pdl_sdbx_apikey_xxx... # From Developer Tools > Authentication > API Keys
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxx... # From Developer Tools > Authentication > Client Side Tokens
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx... # From Developer Tools > Notifications > Webhook Settings
PADDLE_CREDITS_PRODUCT_ID=pro_xxx... # Your credits product ID

# Supabase (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Email
RESEND_API_KEY=your_api_key

# Sentry (Error Logging)
NEXT_PUBLIC_SENTRY_DSN=your_dsn_here
SENTRY_PROJECT=your_project_name
SENTRY_AUTH_TOKEN=your_auth_token

# AWS S3
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="your-bucket-name"
AWS_S3_BUCKET_NAME="your-bucket-name"

# Cloudflare R2 for profile bento media uploads
R2_ACCOUNT_ID="your-account-id"
R2_BUCKET_NAME="your-r2-bucket-name"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_PUBLIC_BASE_URL="https://your-public-r2-domain.example.com"

# Inngest (Background Jobs)
INNGEST_EVENT_KEY=

# DB Extension
DB_MODULES= # coupons,contact,paypal,waitlist
